# =============================================================================
# Enterprise Insight Agent V4 — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values.

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Embedding — Ollama BGE-M3 (http://localhost:11434, 1024 dims)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=bge-m3:latest
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=sk-your-openai-key

# Database — replace with your own credentials
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enterprise_db
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/enterprise_db
DATABASE_URL_TEST=sqlite+aiosqlite:///./test.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Server
SERVER_PORT=8002

# CORS — comma-separated allowed origins. Set to "*" only for development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL container credentials (used by docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_db
POSTGRES_PORT=5434

# Redis container port (used by docker-compose.yml)
REDIS_PORT=6381

# n8n container port (used by docker-compose.yml)
N8N_PORT=5680

# Customer Schema Adapter
CUSTOMER_SCHEMA_YAML=customer_schema.yaml

# Proxy isolation is handled at the httpx client level (trust_env=False in app/llm.py).
# No need to set HTTP_PROXY / NO_PROXY here.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console   # "console" | "json"（生产环境设置 LOG_FORMAT=json）

# System
SYSTEM_USER_ID=0     # 系统用户 ID，用于定时任务（周报生成等）

# n8n
N8N_WEBHOOK_SECRET=whsec-change-me

# pgvector
EMBEDDING_DIMENSION=1024

# Analysis limits
MAX_SQL_ROWS=1000
MAX_PARALLEL_AGENTS=3

# =============================================================================
# V4 Feature Flags — all enabled by default (validated by 137 tests)
# =============================================================================
# P0: Core experience upgrades
FEATURE_CHART=true
FEATURE_MULTI_TURN=true
FEATURE_DATA_TRACE=true
# P1: Quality of life
FEATURE_MOBILE_UI=true
FEATURE_FEEDBACK=true
FEATURE_PROMPT_YAML=true
# P2: Operations
FEATURE_APM=true
FEATURE_FRIENDLY_ERRORS=true
