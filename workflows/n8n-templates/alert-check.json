{
  "name": "V4 异常检测与预警",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "每天 08:30 检测一次",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8002/api/v1/alerts/check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer your-webhook-secret-here"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-request",
      "name": "检测异常指标",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.alerts_created }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-check",
      "name": "有异常？",
      "type": "n8n-nodes-base.if",
      "position": [750, 300]
    }
  ],
  "connections": {
    "schedule-trigger": {
      "main": [
        [
          {
            "node": "http-request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "http-request": {
      "main": [
        [
          {
            "node": "if-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Shanghai"
  },
  "description": "每天 08:30 自动检测经营指标异常。检测到异常后通过配置的 webhook（飞书/钉钉/企微）推送通知。需要先在 .env 中配置 N8N_WEBHOOK_SECRET 和对应的 WEBHOOK_URL。\n\n触发器格式说明（2026-09-14 T-16 踩坑）：triggerAtHour/triggerAtMinute 必须写在 interval 数组项**内部**；此前写成 \"interval\":[{\"field\":\"hours\",...}], \"triggerAtMinute\":0（项外）被 n8n 忽略，表现为重启后跑几次即静默（9/2 起停摆 13 天无人发现）。此格式对齐金丝雀工作流（实测长期稳定）。08:30 与应用内兜底 09:30 错开：兜底看到本次调用的审计记录即幂等跳过。"
}
