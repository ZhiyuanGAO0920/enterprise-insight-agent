# ============================================================
# Enterprise Insight Agent V4 — Production Configuration
# ============================================================
# Copy to .env and fill in the required values.
#   cp .env.production.example .env
#
# WARNING: .env contains secrets. NEVER commit it to git.
# Use Docker Secrets (recommended) or restrict file permissions:
#   chmod 600 .env
# ============================================================

# ---- Required (MUST change) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx          # DeepSeek API Key (REQUIRED)
JWT_SECRET_KEY=change-me-to-random-64-chars    # JWT signing key (REQUIRED)
POSTGRES_PASSWORD=change-me-strong-password    # Database password (REQUIRED)
N8N_WEBHOOK_SECRET=whsec-change-me             # n8n webhook auth (REQUIRED)

# ---- LLM Configuration ----
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# ---- Embedding (local BGE-M3 via Ollama) ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=bge-m3:latest
OLLAMA_BASE_URL=http://ollama-v4:11434
EMBEDDING_DIMENSION=1024

# ---- Database URLs (Docker compose sets these automatically) ----
# In docker-compose.prod.yml, these are constructed from POSTGRES_* vars.
# Only set manually if NOT using the provided docker-compose.
# DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/enterprise_db
# DATABASE_URL_SYNC=postgresql+psycopg2://admin:password@localhost:5432/enterprise_db

# ---- Redis (Docker compose sets this automatically) ----
# REDIS_URL=redis://redis-v4:6379/0

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Recommended to review ----
POSTGRES_USER=admin
POSTGRES_DB=enterprise_db
CORS_ORIGINS=*                                 # Production: restrict to specific domain(s)

# ---- Optional ports (change if conflicts exist) ----
SERVER_PORT=8002                               # Web UI & API
POSTGRES_PORT=5434                             # PostgreSQL (V4 uses 5434, not 5432)
REDIS_PORT=6381                                # Redis (V4 uses 6381)
OLLAMA_PORT=11435                              # Ollama embedding API
N8N_PORT=5680                                  # n8n workflow automation

# ---- Logging ----
LOG_LEVEL=WARNING                              # WARNING for production, INFO for debugging
LOG_FORMAT=json                                # json for production, console for development

# ---- System ----
SYSTEM_USER_ID=0                               # System user ID for scheduled tasks

# ---- Analysis limits ----
MAX_SQL_ROWS=1000
MAX_PARALLEL_AGENTS=3

# ---- Customer Schema ----
CUSTOMER_SCHEMA_YAML=customer_schema.yaml

# =============================================================================
# V4 Feature Flags — all enabled by default
# =============================================================================
# P0: Core experience
FEATURE_CHART=true
FEATURE_MULTI_TURN=true
FEATURE_DATA_TRACE=true
# P1: Quality of life
FEATURE_MOBILE_UI=true
FEATURE_FEEDBACK=true
FEATURE_PROMPT_YAML=true
# P2: Operations
FEATURE_APM=true
FEATURE_FRIENDLY_ERRORS=true

# ---- Notification Webhooks (optional, leave empty to disable) ----
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
