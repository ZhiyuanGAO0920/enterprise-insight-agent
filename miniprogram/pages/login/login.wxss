.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-surface) 100%);
}

.login-header {
  text-align: center;
  margin-bottom: 100rpx;
}

.logo {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  background: var(--gradient-primary);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 36rpx;
  /* 顶部内高光 + 双层弥散光晕：与 AI 助手空状态同款品牌底盘 */
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.28),
    0 24rpx 56rpx rgba(26, 115, 232, 0.35),
    0 6rpx 16rpx rgba(26, 115, 232, 0.22);
}

/* EIA 品牌标识（assets/brand/eia-white.png，180x80，由 scripts/gen_icons.py 生成）：
   与 AI 助手空状态共用同一资产，PNG 渲染跨端一致（不依赖系统 900 字重）；
   比例 180:80 = 2.25:1，显示 112x50rpx（= 112/2.25）与 chat 页空状态一致 */
.logo-img {
  width: 112rpx;
  height: 50rpx;
}

.app-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.app-subtitle {
  font-size: var(--font-size-xs);
  letter-spacing: 3rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.login-form {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-card-hover);
}

.wechat-btn {
  /* 同 bind submit-btn：flex 接管垂直居中，绕开 button 组件字体基线偏下问题 */
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07C160;
  color: var(--color-surface);
  border-radius: var(--radius-md);
  height: 96rpx;
  font-size: var(--font-size-lg);
  font-weight: 600;
  padding: 0;
  border: none;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.wechat-btn::after {
  border: none;
}

.wechat-btn[disabled] {
  opacity: 0.6;
}

.bind-link {
  text-align: center;
  margin-top: var(--space-4);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.agreement {
  text-align: center;
  margin-top: var(--space-3);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  text-decoration: underline;
}

.login-footer {
  margin-top: 80rpx;
  text-align: center;
}

.footer-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
