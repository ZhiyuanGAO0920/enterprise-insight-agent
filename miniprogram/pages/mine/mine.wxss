.mine-container {
  padding: 32rpx;
  min-height: 100vh;
}

.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1A73E8 0%, #4A9AF5 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.2);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #1A73E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  margin-right: 32rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #F0F0F3;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #86868B;
}

.menu-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D1D1F;
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #86868B;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}

.logout-section {
  padding: 48rpx 0;
}

.logout-btn {
  background: #FFFFFF;
  text-align: center;
  padding: 32rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #FF3B30;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
