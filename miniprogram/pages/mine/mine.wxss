.mine-container {
  padding: 32rpx;
  min-height: 100vh;
  background: var(--color-surface-subtle);
}

.profile-card {
  display: flex;
  align-items: center;
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-primary);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-3xl);
  font-weight: 600;
  margin-right: var(--space-4);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.username {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-surface);
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.8);
}

.stat-card {
  display: flex;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 40rpx 0;
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--color-border);
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.menu-list {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-4);
  border-bottom: 1rpx solid var(--color-surface-subtle);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  margin-right: var(--space-3);
  flex-shrink: 0;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: var(--font-size-lg);
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.menu-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
}

.logout-section {
  padding: 48rpx 0;
}

.logout-btn {
  background: var(--color-surface);
  text-align: center;
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-lg);
  color: var(--color-danger);
  font-weight: 500;
  box-shadow: var(--shadow-card);
}
