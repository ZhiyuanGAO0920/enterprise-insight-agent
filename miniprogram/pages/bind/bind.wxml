<view class="bind-container">
  <view class="form-section">
    <view class="section-title">绑定系统账号</view>
    <view class="section-desc">首次使用微信登录需绑定已有系统账号</view>

    <view class="form-group">
      <view class="form-label">账号</view>
      <view class="form-field {{focusField === 'username' ? 'focused' : ''}}">
        <input
          class="form-field-input"
          placeholder="请输入账号"
          value="{{username}}"
          data-field="username"
          bindinput="onInput"
          bindfocus="onFocus"
          bindblur="onBlur"
        />
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">密码</view>
      <view class="pwd-field {{focusField === 'password' ? 'focused' : ''}}">
        <input
          class="pwd-input"
          placeholder="请输入密码"
          password="{{!showPassword}}"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          bindfocus="onFocus"
          bindblur="onBlur"
        />
        <view class="pwd-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
      </view>
    </view>

    <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

    <button
      class="submit-btn"
      bindtap="handleBind"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      绑定并登录
    </button>
  </view>
</view>
