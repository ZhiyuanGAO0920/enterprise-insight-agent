.home-container {
  min-height: 100vh;
  background: var(--color-surface-subtle);
  padding-bottom: 180rpx;
}

/* 问候栏 */
.greeting-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 32rpx 24rpx;
}

.greeting-text {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}

.date-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* 视图切换 */
.view-switch {
  display: flex;
  background: var(--color-fill-hover);
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin: 0 32rpx 24rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
  font-weight: 500;
  transition: all 0.25s;
}

.switch-item.active {
  background: var(--color-surface);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: var(--shadow-card-hover);
}

/* 告警卡片 */
.alert-section {
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.alert-card {
  display: flex;
  align-items: center;
  background: rgba(255, 149, 0, 0.08);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid var(--color-warning);
  box-shadow: 0 2rpx 16rpx rgba(255, 149, 0, 0.08);
}

.alert-card.alert-high {
  background: rgba(255, 59, 48, 0.06);
  border-left-color: var(--color-danger);
  box-shadow: 0 2rpx 16rpx rgba(255, 59, 48, 0.08);
}

.alert-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
}

.alert-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.alert-action {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  font-weight: 500;
}

.alert-card.alert-high .alert-action {
  color: var(--color-danger);
}

/* 告警卡按压反馈（hover-class）：同色系加深一档，避免 hover 灰色遮色 */
.alert-hover {
  background: rgba(255, 149, 0, 0.16);
}

.alert-card.alert-high.alert-hover {
  background: rgba(255, 59, 48, 0.12);
}

/* 指标卡片 */
.metric-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin: 0 32rpx 16rpx;
  box-shadow: var(--shadow-card);
}

.metric-card.half {
  flex: 1;
  margin: 0;
  padding: 28rpx;
}

.metric-row {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.metric-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.metric-value {
  font-size: var(--font-size-4xl);
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: -1rpx;
}

.metric-value.small {
  font-size: var(--font-size-3xl);
}

.metric-unit {
  font-size: var(--font-size-sm);
  font-weight: 400;
  color: var(--color-text-secondary);
  margin-left: 8rpx;
}

.metric-change {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-sm);
  font-weight: 500;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-top: 12rpx;
}

.metric-change.text-green {
  background: rgba(48, 209, 88, 0.12);
  color: var(--color-success);
}

.metric-change.text-red {
  background: rgba(255, 59, 48, 0.12);
  color: var(--color-danger);
}

.metric-change.text-gray {
  background: var(--color-fill-hover);
  color: var(--color-text-secondary);
}

.money-symbol {
  font-size: var(--font-size-lg);
  opacity: 0.6;
  margin-right: 4rpx;
}

/* 趋势图 */
.trend-card,
.top-stores-card,
.regions-card,
.refund-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.trend-placeholder {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.trend-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
  gap: 8rpx;
}

.bar {
  flex: 1;
  background: var(--gradient-primary);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 16rpx;
}

/* 趋势峰值提示 */
.trend-peak {
  margin-top: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

/* 条目点击反馈 + 箭头 */
.tap-feedback {
  background: var(--color-fill-hover);
  border-radius: var(--radius-sm);
}

.item-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
  margin-left: 12rpx;
  line-height: 1;
}

/* 数据更新时间 */
.updated-at {
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  padding: 8rpx 0 24rpx;
}

/* 门店列表 */
.store-list {
  display: flex;
  flex-direction: column;
}

.store-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-subtle);
}

.store-item:last-child {
  border-bottom: none;
}

.store-rank {
  width: 44rpx;
  height: 44rpx;
  background: var(--color-surface-subtle);
  color: var(--color-text-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 冠军门店高亮：只有 Top1 用品牌渐变，2-5 名退为中性灰，排名一眼可辨 */
.store-rank.top1 {
  background: var(--gradient-primary);
  color: var(--color-surface);
}

.store-name {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: 500;
}

.store-value {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text);
}

/* 快捷入口 */
.ask-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: var(--shadow-primary);
}

.ask-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.ask-text {
  flex: 1;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-surface);
}

.ask-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-surface);
  opacity: 0.8;
}

/* 看板网格：2×2 卡片 */
.overview-grid {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.overview-row {
  display: flex;
  margin-bottom: 16rpx;
}

.overview-row:last-child {
  margin-bottom: 0;
}

.overview-cell {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-right: 16rpx;
}

.overview-cell:last-child {
  margin-right: 0;
}

.cell-value {
  font-size: var(--font-size-3xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
  letter-spacing: -0.5rpx;
}

.cell-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* 区域列表 */
.region-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.region-item {
  display: flex;
  align-items: center;
}

.region-name {
  width: 120rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: 500;
}

.region-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: var(--color-fill-hover);
  border-radius: var(--radius-sm);
  margin: 0 16rpx;
  overflow: hidden;
}

.region-bar {
  height: 100%;
  background: var(--gradient-primary);
  border-radius: var(--radius-sm);
  transition: width 0.3s;
}

.region-value {
  width: 140rpx;
  font-size: var(--font-size-sm);
  text-align: right;
  color: var(--color-text);
  font-weight: 600;
}

/* 退款列表 */
.refund-list {
  display: flex;
  flex-direction: column;
}

.refund-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-subtle);
}

.refund-item:last-child {
  border-bottom: none;
}

.refund-name {
  font-size: var(--font-size-base);
  color: var(--color-text);
  font-weight: 500;
}

.refund-rate {
  font-size: var(--font-size-base);
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
}

/* 骨架屏（基础 .skeleton 与动画见 app.wxss） */
.skeleton-wrap {
  padding: 32rpx;
}

.skeleton-header {
  height: 80rpx;
  width: 50%;
}

.skeleton-card {
  height: 180rpx;
}
