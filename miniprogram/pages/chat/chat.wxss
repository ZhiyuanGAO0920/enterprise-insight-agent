.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-surface-subtle);
}

/* 消息区域 */
.message-area {
  flex: 1;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 48rpx 32rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--gradient-primary);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 115, 232, 0.25);
}

.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 48rpx;
}

.suggestion-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--color-text);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.suggestion-item:active {
  background: var(--color-surface-subtle);
  transform: scale(0.98);
}

.suggestion-icon {
  width: 56rpx;
  height: 56rpx;
  background: var(--color-surface-subtle);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  margin-bottom: 8rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.message-item.user .message-avatar {
  background: var(--gradient-primary);
  margin-left: 16rpx;
}

.message-item.assistant .message-avatar {
  background: var(--color-surface);
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.message-bubble {
  max-width: 78%;
}

.message-item.user .message-bubble {
  background: var(--gradient-primary);
  color: var(--color-surface);
  border-radius: 24rpx 24rpx 6rpx 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 115, 232, 0.25);
}

.message-item.assistant .message-bubble {
  background: var(--color-surface);
  color: var(--color-text);
  border-radius: 24rpx 24rpx 24rpx 6rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.message-time {
  font-size: 22rpx;
  opacity: 0.6;
  margin-bottom: 8rpx;
}

.message-content {
  font-size: 30rpx;
  line-height: 1.6;
}

/* 报告预览 */
.report-section {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.report-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.report-full-link {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.report-preview {
  font-size: 28rpx;
  color: var(--color-text-body);
  line-height: 1.8;
  max-height: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 8;
  -webkit-box-orient: vertical;
}

.followup-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.followup-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.followup-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.followup-item {
  background: rgba(26, 115, 232, 0.06);
  color: var(--color-primary);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.followup-item:active {
  background: rgba(26, 115, 232, 0.12);
}

.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  background: var(--color-surface-subtle);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

/* 进度指示 */
.progress-section {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 28rpx;
}

/* 胶囊进度条（默认收起，点击展开 5 步明细） */
.progress-capsule {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(26, 115, 232, 0.06);
  border-radius: 20rpx;
}

.capsule-step-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.capsule-info {
  flex: 1;
}

.capsule-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.capsule-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.capsule-arrow {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  transition: transform 0.25s;
}

.capsule-arrow.open {
  transform: rotate(180deg);
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-step {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.progress-step .step-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-surface-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: all 0.3s;
}

.progress-step.done .step-icon {
  background: var(--color-success);
  color: var(--color-surface);
}

.progress-step.running .step-icon {
  background: var(--gradient-primary);
  color: var(--color-surface);
  animation: pulse 1.5s infinite;
}

.progress-step.pending .step-icon {
  opacity: 0.4;
}

.progress-step .step-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.progress-step.pending .step-label {
  color: var(--color-text-secondary);
}

@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(26, 115, 232, 0.4); }
  50% { opacity: 0.8; box-shadow: 0 0 0 12rpx rgba(26, 115, 232, 0); }
}

.abort-btn {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx;
  background: rgba(255, 59, 48, 0.1);
  color: var(--color-danger);
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 加载点 */
.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  animation: bounce 1.4s infinite;
}

.loading-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 输入栏 */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-surface);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-surface-subtle);
  border-radius: 28rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
}

.input-grow {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.question-input {
  flex: 1;
  /* width:100% 兜底：真机上原生 input 最小宽度异常时可确保撑满 wrapper */
  width: 100%;
  background: transparent;
  font-size: 30rpx;
  color: var(--color-text);
  min-height: 72rpx;
  max-height: 200rpx;
}

.question-input::placeholder {
  color: var(--color-text-secondary);
}

.send-btn {
  background: var(--color-primary);
  color: var(--color-surface);
  border-radius: 50%;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
  flex-shrink: 0;
}

.send-btn:active {
  transform: scale(0.95);
}

.send-btn:disabled {
  opacity: 0.5;
}

/* 停止生成：loading 时替换发送键（同步模式也可中断等待） */
.stop-btn {
  background: #ff3b30;
  color: #ffffff;
  border-radius: 50%;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255, 59, 48, 0.3);
}

.stop-btn:active {
  transform: scale(0.95);
}

.history-btn,
.full-btn {
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.15s ease;
}

.btn-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1;
}

.history-btn:active,
.full-btn:active {
  transform: scale(0.94);
  background: var(--color-surface-subtle);
}

/* 历史抽屉 */
.history-drawer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 100;
}

.history-drawer.show {
  pointer-events: auto;
}

.drawer-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  opacity: 0;
  transition: opacity 0.3s;
}

.history-drawer.show .drawer-mask {
  opacity: 1;
}

.drawer-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 85%;
  max-width: 640rpx;
  background: var(--color-surface);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.history-drawer.show .drawer-content {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 32rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.drawer-clear {
  font-size: 28rpx;
  color: var(--color-danger);
  font-weight: 500;
}

.drawer-list {
  flex: 1;
  padding: 16rpx;
}

.history-item {
  padding: 28rpx;
  background: var(--color-surface-subtle);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.history-time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.history-question {
  font-size: 26rpx;
  color: #636366;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-empty {
  text-align: center;
  padding: 80rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}