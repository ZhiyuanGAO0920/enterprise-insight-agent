.share-container {
  padding: 32rpx;
  min-height: 100vh;
  background: var(--color-surface-subtle);
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: var(--space-4);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

/* 失效/错误页 */
.expired-wrap,
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.expired-icon,
.error-icon {
  margin-bottom: var(--space-4);
}

.expired-title,
.error-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.expired-desc {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  margin-bottom: 48rpx;
}

.expired-action {
  background: var(--color-primary);
  color: var(--color-surface);
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 56rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-lg);
  font-weight: 500;
}

/* 分享卡片 */
.share-card {
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-primary);
}

.share-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  color: var(--color-surface);
  font-size: var(--font-size-xs);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  margin-bottom: var(--space-3);
}

.share-conclusion {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-surface);
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.share-conclusion.expanded {
  display: block;
  -webkit-line-clamp: unset;
  overflow: visible;
}

.share-expand {
  display: inline-block;
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  margin-bottom: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.share-time {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.7);
}

.share-quality {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  font-weight: 500;
  margin-top: 12rpx;
}

.share-quality.pass { color: rgba(255, 255, 255, 0.9); }
.share-quality.fail { color: #FFE08A; }

/* 发现区 */
.finding-section {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-icon {
  font-size: var(--font-size-lg);
  margin-right: 16rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}

.finding-list {
  margin-bottom: var(--space-4);
}

.finding-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-surface-subtle);
}

.finding-item:last-child {
  border-bottom: none;
}

.finding-index {
  width: 44rpx;
  height: 44rpx;
  background: rgba(26, 115, 232, 0.1);
  color: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.finding-index.rec {
  background: rgba(255, 149, 0, 0.1);
  color: var(--color-warning);
}

.finding-text {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.6;
}

.empty-finding {
  text-align: center;
  padding: 40rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.cta-btn {
  text-align: center;
  background: var(--color-primary);
  color: var(--color-surface);
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: var(--radius-md);
  font-size: var(--font-size-lg);
  font-weight: 500;
  margin-top: var(--space-3);
}

/* 登录提示 */
.login-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-top: var(--space-4);
  box-shadow: var(--shadow-card);
}

.prompt-text {
  font-size: var(--font-size-md);
  color: var(--color-text);
}

.prompt-btn {
  background: var(--color-primary);
  color: var(--color-surface);
  padding: 16rpx 36rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-md);
  font-weight: 500;
}
