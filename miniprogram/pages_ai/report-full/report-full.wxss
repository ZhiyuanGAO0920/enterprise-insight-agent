.report-container {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 页面级滚动（canvas 2d 在 scroll-view 内滚动不同步）：
   bottom 大 padding 为 fixed 操作栏让位 */
.report-scroll {
  padding: 32rpx;
  padding-bottom: 180rpx;
}

.report-header-section {
  text-align: center;
  padding: 40rpx 24rpx;
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-4);
}

.rpt-title {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--color-surface);
  line-height: 1.4;
}

.report-body {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.rpt-h1 {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text);
  margin: 40rpx 0 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--color-border-subtle);
}

.rpt-h1:first-child {
  margin-top: 0;
}

.rpt-h2 {
  display: flex;
  align-items: center;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-primary);
  margin: 36rpx 0 20rpx;
}

.rpt-h3 {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
  margin: 28rpx 0 16rpx;
}

.rpt-p {
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.8;
  margin: 16rpx 0;
}

.rpt-list {
  margin: 16rpx 0;
  padding-left: 16rpx;
}

.rpt-li {
  display: flex;
  align-items: flex-start;
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.8;
  margin: 8rpx 0;
}

.rpt-li .bullet {
  margin-right: 16rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.rpt-quote {
  background: rgba(26, 115, 232, 0.05);
  border-left: 6rpx solid var(--color-primary);
  padding: 20rpx 24rpx;
  margin: 20rpx 0;
  font-size: var(--font-size-md);
  color: var(--color-text-body);
  line-height: 1.6;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.chart-section {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-top: var(--space-3);
  box-shadow: var(--shadow-card);
}

.chart-item {
  background: var(--color-surface-subtle);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin: 20rpx 0;
}

.chart-title {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.chart-note {
  margin-top: 12rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

/* 表格 */
.rpt-table {
  margin: 20rpx 0;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.rpt-tr {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
}

.rpt-tr:last-child {
  border-bottom: none;
}

.rpt-tr.rpt-head {
  background: var(--color-primary);
}

.rpt-th {
  flex: 1;
  min-width: 0;
  padding: 16rpx 12rpx;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-surface);
  text-align: center;
  word-break: break-all;
}

.rpt-td {
  flex: 1;
  min-width: 0;
  padding: 14rpx 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-body);
  text-align: center;
  word-break: break-all;
  border-right: 1rpx solid var(--color-border-subtle);
}

.rpt-td:last-child {
  border-right: none;
}

.report-footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.footer-divider {
  width: 200rpx;
  height: 2rpx;
  background: var(--color-border);
  margin: 0 auto 24rpx;
}

.footer-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: var(--color-surface);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-top);
}

.action-bar .action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text);
}

.action-bar .action-icon {
  margin-bottom: 8rpx;
}

/* 反馈弹窗 */
.feedback-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  pointer-events: none;
}

.feedback-modal.show {
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.3s;
}

.feedback-modal.show .modal-mask {
  opacity: 1;
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 48rpx 32rpx;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.feedback-modal.show .modal-content {
  transform: translateY(0);
}

.modal-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 40rpx;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.star {
  font-size: 80rpx;
  color: var(--color-border);
  transition: color 0.2s;
}

.star.active {
  color: var(--color-warning);
}

.rating-text {
  text-align: center;
  font-size: var(--font-size-md);
  color: var(--color-text);
  margin-bottom: 40rpx;
}

.reason-section {
  margin: var(--space-4) 0;
}

.reason-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.reason-chip {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface-subtle);
  color: var(--color-text-body);
  font-size: var(--font-size-sm);
  font-weight: 500;
  border: 1rpx solid transparent;
}

.reason-chip.active {
  background: rgba(26, 115, 232, 0.1);
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.modal-actions {
  display: flex;
  gap: var(--space-3);
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: 500;
}

.modal-btn.cancel {
  background: var(--color-surface-subtle);
  color: var(--color-text);
}

.modal-btn.confirm {
  background: var(--color-primary);
  color: var(--color-surface);
}

.success-tip {
  text-align: center;
  margin-top: var(--space-3);
  font-size: var(--font-size-md);
  color: var(--color-success);
}
